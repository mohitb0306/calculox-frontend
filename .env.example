# The URL of your existing PHP Backend (Local/Server)
# NOTE: We added "/api" to the end so it finds the correct folder
NEXT_PUBLIC_API_URL=

# The URL of the Next.js Frontend (itself)
NEXT_PUBLIC_APP_URL=

# Security
# WARNING: Add your real 64-character JWT_SECRET directly inside the Coolify server dashboard. NEVER put it here.
JWT_SECRET=

# ⚙️ What you need to do next:
# Environment: development, staging, or production
NEXT_PUBLIC_APP_ENV=
